# swiss-ip-mcp — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- IGE / Swissreg API credentials (required) -----------------------------
# Free after signing the IGE usage terms:
# https://www.ige.ch/en/services/digital-resources/ip-data/data-delivery-api
IGE_USERNAME=your_ige_username
IGE_PASSWORD=your_ige_password

# --- Transport (optional; default: stdio) ----------------------------------
# stdio | sse | streamable-http
MCP_TRANSPORT=stdio

# --- HTTP transport binding (only used when MCP_TRANSPORT != stdio) ---------
# Bind to 0.0.0.0 ONLY inside a container / behind a reverse proxy.
MCP_HOST=127.0.0.1
PORT=8000

# Comma-separated CORS origin allow-list (no wildcard in production).
MCP_ALLOWED_ORIGINS=
# Comma-separated Host-header allow-list; enables DNS-rebinding protection.
MCP_ALLOWED_HOSTS=
